{
  "name": "koi-splash",
  "version": "1.0.0",
  "description": "Koi Splash - a calm but juicy match-3 on a moonlit pond (PixiJS + TypeScript)",
  "homepage": "https://danieldaniel128.github.io/koi-splash/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieldaniel128/koi-splash.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "bake:art": "node tools/bakeArt.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools && tsc --noEmit -p tools/bake",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  }
}
